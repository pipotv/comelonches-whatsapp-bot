# ===============================================
# CONFIGURACIÓN DEL BOT DE WHATSAPP - COMELONCHES
# ===============================================

# 1. Tu API Key de Google Gemini (Gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. Configuración del Servidor Web (para ver el código QR en el navegador)
PORT=3000

# 3. Datos del Negocio
BUSINESS_NAME=Comelonches
BUSINESS_SLOGAN=¡El auténtico sabor y los mejores lonches!
BUSINESS_WEBSITE=https://comelonches.com
BUSINESS_PHONE=+52 1 000 000 0000
BUSINESS_ADDRESS=Av. Principal #123, Tu Ciudad

# 4. Horarios de Atención
BUSINESS_HOURS=Lunes a Sábado de 9:00 AM a 10:00 PM, Domingos de 10:00 AM a 8:00 PM

# 5. Comportamiento del Bot
# Tiempo en milisegundos simulando "escribiendo..." (1500 = 1.5 segundos)
BOT_TYPING_DELAY_MS=1500
